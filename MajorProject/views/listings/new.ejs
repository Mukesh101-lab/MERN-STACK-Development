<% layout('/layouts/boilerplate') -%>
<body>
    
    <div class="row">
    <div class="col-8 offset-2">
    <h3>Create a New Listing</h3>
    <form method="POST" action="/listings" novalidate class="needs-validation">
    <div class="mb-3">
        <label class="form-label">Title</label>
        <input 
            type="text" 
            class="form-control"
            placeholder="Title" 
            name="listing[title]"
            required
        >
        <div class="valid-feedback">Title looks good!</div>
    </div>
    <div class="mb-3">
        <label class="form-label">Description</label>
        <input 
            type="text" 
            class="form-control"
            placeholder="Description" 
            name="listing[description]"
            required
        >
        <div class="invalid-feedback">Please Valid Description</div>
    </div>
    <div class="mb-3">
        <label class="form-label">Image Link</label>
        <input 
            type="text" 
            class="form-control"
            placeholder="Image link" 
            name="listing[image][url]"
        >
    </div>
    <div class="row">
    <div class="mb-3 col-4">
        <label class="form-label">Price</label>
        <input 
            
            class="form-control"
            placeholder="Price" 
            name="listing[price]"
            required
        >
        <div class="invalid-feedback">Please Valid Price</div>
    </div>
    <div class="mb-3 col-8">
        <label class="form-label">Country</label>
        <input 
            type="text" 
            class="form-control"
            placeholder="Country" 
            name="listing[country]"
            required
        >
        <div class="invalid-feedback">Please Valid Country Name</div>
    </div>
    </div>
    <div class="mb-3">
        <label class="form-label">Location</label>
        <input 
            type="text" 
            class="form-control"
            placeholder="Location" 
            name="listing[location]"
            required
        >
        <div class="invalid-feedback">Please Valid Location</div>
    </div>
    <button class="btn btn-dark add-btn">Add</button>
    </form>
    </div>
    </div>
</body>
