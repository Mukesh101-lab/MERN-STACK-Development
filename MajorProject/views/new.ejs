<% layout('/layouts/boilerplate') -%>
<body>
    
    <form method="post" action="/listings">
        <input type="text" placeholder="image link" name="listing[image]"><br><br>
        <input type="text" placeholder="title" name="listing[title]"><br><br>
        <input type="text" placeholder="description" name="listing[description]"><br><br>
        <input type="number" placeholder="price" name="listing[price]"><br><br>
        <input type="text" placeholder="location" name="listing[location]"><br><br>
        <input type="text" placeholder="country" name="listing[country]"><br><br>
        <button>Submit</button>
    </form>
</body>
