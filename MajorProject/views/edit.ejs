<% layout('/layouts/boilerplate') -%>
<body>
      <h1>Edit Listing</h1>

    <form method="POST" action="/listings/<%= listing._id %>?_method=PUT">
        <input 
            type="text" 
            name="listing[image]" 
            value="<%= listing.image %>"
            placeholder="Image Link"
        >
        <br><br>
        <input 
            type="text" 
            name="listing[title]" 
            value="<%= listing.title %>"
            placeholder="Title"
        >
        <br><br>
        <input 
            type="text" 
            name="listing[description]" 
            value="<%= listing.description %>"
            placeholder="Description"
        >
        <br><br>
        <input 
            type="number" 
            name="listing[price]" 
            value="<%= listing.price %>"
            placeholder="Price"
        >
        <br><br>
        <input 
            type="text" 
            name="listing[location]" 
            value="<%= listing.location %>"
            placeholder="Location"
        >
        <br><br>
        <input 
            type="text" 
            name="listing[country]" 
            value="<%= listing.country %>"
            placeholder="Country"
        >
        <br><br>
        <button>Update</button>
    </form>

</body>
