<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>edit data</title>
</head>
<body>
    <h1>edit data</h1>
    <form action="/users/<%= data.id %>/edit?_method=PUT" method="POST">
        <input type="text" name="username" value="<%= data.username %>" required><br>
        <input type="email" name="email" value="<%= data.email %>" required><br>
        <input type="password" name="password" value="<%= data.password %>" required><br>
        <button type="submit">Update</button>
    </form>
</body>
</html>