<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>show data</title>
</head>
<body>
    <h1>show data</h1>
    <table border="1">
        <tr>
            <th>ID</th>
            <th>Username</th>
            <th>Email</th>
            <th>Password</th>
        </tr>
        <tr>
            <td><%= data.id %></td>
            <td><%= data.username %></td>
            <td><%= data.email %></td>
            <td><%= data.password %></td>
            <td><a href="/users/<%= data.id %>/edit">edit</a></td>
        </tr>        
    </table>
</body>
</html>