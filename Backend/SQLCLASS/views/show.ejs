<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <h1>Show All data user</h1>
     <table border="black">
        <header>
            <tr>
                <th>id</th>
                <th>username</th>
                <th>email</th>
                <th>password</th>
            </tr>
        </header>
        <body>
            <% for(value of data){ %>
                <tr>
                    <td><%= value.id %></td>
                    <td><%= value.username %></td>
                    <td><%= value.email %></td>
                    <td><%= value.password %></td>
                </tr>
            <% } %>
        </body>
    </table>
</body>
</html>