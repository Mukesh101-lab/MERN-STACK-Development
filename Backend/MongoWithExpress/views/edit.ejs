<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="/edit.css">
</head>
<body>
    <h1>Edit Chat</h1>
    <form action="/chats/<%= chat._id %>?_method=PUT" method="POST">
        <label for="from">From:</label>
        <input type="text" id="from" name="from" value="<%= chat.from %>" required><br><br>
        <label for="to">To:</label>
        <input type="text" id="to" name="to" value="<%= chat.to %>" required><br><br>
        <label for="msg">Message:</label>
        <textarea id="msg" name="msg" required><%= chat.msg %></textarea><br><br>
        <button type="submit">Update Chat</button>
    </form>
</body>
</html>