<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="/index.css">
</head>
<body>
    <h1>Whatsapp Chats</h1>
    <ul>
        <% chats.forEach(chat => { %>
            <div class="chats">
                <p>From: <%= chat.from %></p>
                <p>Message: <%= chat.msg %></p>
                <p>To: <%= chat.to %></p>
                <p><a href="/chats/<%= chat._id %>/edit">edit</a></p>
                <form action="/chats/<%= chat._id %>?_method=DELETE" method="POST">
                    <button type="submit">Delete Chat</button>
                </form>
                <form method="get" action="/chats/<%= chat._id %>">
                    <button>show</button>
                </form>
                <hr>
                <p>Created At: <%= chat.created_at.toString().split(' ')[4] %></p>
                <p><%= chat.created_at.toString().split(' ').splice(0, 4).join(' ') %></p>
            </div>
        <% }); %>
        <a href="/chats/new">Create New Chat</a>
    </ul>
</body>
</html>