<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Posts</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Roboto:ital,wght@0,100..900;1,100..900&display=swap"
        rel="stylesheet">
    <link rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0&icon_names=settings" />
</head>

<body>
    <h1>Quora</h1>
    <% for(post of posts) {%>
        <div>
            <h3>name : <%= post.name %>
            </h3>
            <p>content : <%= post.content %>
            </p>
            <br>
            <a href="http://localhost:8080/posts/<%= post.id %>">show</a>
            <form action="/posts/<%= post.id %>?_method=DELETE" method="POST">
                <button>Delete</button>
            </form>
        </div>
        <% } %>
            <a href="http://localhost:8080/posts/new">Create new Post</a>
            <span class="material-symbols-outlined">
                settings
            </span>
</body>

</html>